# ── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5002
CLIENT_URL=http://localhost:5174

# ── Database ──────────────────────────────────────────────────────────────
# Local MongoDB instance or Atlas connection string. The database name MUST
# be explicit in the URI path (e.g. "/nalanda_teacher") — this cluster is
# shared with the student and admin backends, and omitting the db name
# silently defaults to a database literally named "test", colliding with
# whatever else connects the same way. Never leave this path segment blank.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/nalanda_teacher?appName=<appName>

# ── Auth ──────────────────────────────────────────────────────────────────
# Generate strong random secrets, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=8h
JWT_REMEMBER_EXPIRES_IN=30d
COOKIE_NAME=nalanda_teacher_token

# ── Security ──────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# ── Uploads ───────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=10

# ── Seed (development only) ─────────────────────────────────────────────
SEED_TEACHER_EMAIL=rajesh@nalanda.edu
SEED_TEACHER_PASSWORD=Faculty@Nalanda2026!

# ── Cross-portal bridge (student backend) ───────────────────────────────
# Lets a published announcement actually reach the student portal — a
# separate service/database with no shared user identity, so this uses a
# shared secret rather than a session. Must match INTERNAL_SERVICE_KEY in
# student/backend/.env.example exactly. Leave STUDENT_BACKEND_URL blank to
# disable the bridge entirely (announcements still work within this portal
# alone; publishing never fails because of this).
STUDENT_BACKEND_URL=http://localhost:5001
STUDENT_BACKEND_SERVICE_KEY=replace_with_a_long_random_secret_shared_across_backends

# ── Cross-portal bridge (admin backend) ─────────────────────────────────
# Lets live assignment/quiz/attendance activity reach Admin's monitoring
# dashboard. Reuses STUDENT_BACKEND_SERVICE_KEY above. Leave
# ADMIN_BACKEND_URL blank to disable.
ADMIN_BACKEND_URL=http://localhost:5003

# ── File storage ──────────────────────────────────────────────────────────
# The single "API Environment variable" string from your Cloudinary
# dashboard (cloudinary://<key>:<secret>@<cloud_name>). Uploads go to
# Cloudinary when this is set, and to local disk when it isn't.
#
# Set this in any environment whose filesystem is ephemeral - Render wipes
# ./uploads on every deploy and restart, so avatars and images uploaded
# there disappear without it. Leaving it blank locally is intentional:
# development and the test suites use the disk path.
CLOUDINARY_URL=

# ── Rate limiting store ───────────────────────────────────────────────────
# Connection URL for a shared Redis instance. express-rate-limit's default
# store is per-process, so with more than one instance running the effective
# limit is multiplied by the instance count - measured in production as 26
# consecutive failed logins producing zero 429s. Point every backend at the
# SAME instance; that shared counter is the whole point.
#
# Optional: when unset, limits fall back to per-process and a warning is
# logged at boot rather than the service refusing to start.
REDIS_URL=
