# Nalanda Teacher Frontend - Environment Variables
# Copy this file to .env and adjust values as needed.
# NEVER commit the real .env file.

VITE_TEACHER_API_URL=http://localhost:5002/api/teacher
VITE_SOCKET_URL=http://localhost:5002

# Cross-portal navigation links shown in the teacher UI (e.g. "Other Nalanda Portals").
VITE_ADMIN_PORTAL_URL=http://localhost:5175
VITE_STUDENT_PORTAL_URL=https://www.nalandanexus.com/
