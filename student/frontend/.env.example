# URL of the Nalanda Student backend API (see student/backend/.env.example)
VITE_API_URL=http://localhost:5001/api

# Google Sign-In OAuth 2.0 Client ID (Web application type), same value the
# backend's GOOGLE_CLIENT_ID must be set to. Leave blank to disable the
# Google sign-in button (shows an honest "not available" message instead).
VITE_GOOGLE_CLIENT_ID=
