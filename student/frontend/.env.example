# URL of the Nalanda Student backend API (see student/backend/.env.example).
# Must include the /api path suffix - the code appends routes like /auth/login directly onto this.
# VITE_API_URL is also accepted for backward compatibility, but this name matches
# the admin/teacher portals' VITE_ADMIN_API_URL / VITE_TEACHER_API_URL convention.
VITE_STUDENT_API_URL=https://nalandanexus.onrender.com/api

# Google Sign-In OAuth 2.0 Client ID (Web application type), same value the
# backend's GOOGLE_CLIENT_ID must be set to. Leave blank to disable the
# Google sign-in button (shows an honest "not available" message instead).
VITE_GOOGLE_CLIENT_ID=203773088377-5bm5qpk1v4sn9q05p9gjupef8bm8d8mu.apps.googleusercontent.com