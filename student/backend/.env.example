# ==============================
# Nalanda Student Backend - Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
# ==============================

# Server
PORT=5001
NODE_ENV=development

# Browser origins allowed to call this API, comma-separated. This is the CORS
# allow-list AND the base for links in outgoing email.
#
# Two things bite here, both worth reading before you change a domain:
#
#  1. www and the apex are DIFFERENT origins. Serving the site at
#     www.example.com and example.com means BOTH must be listed, or whichever
#     is missing gets ORIGIN_NOT_ALLOWED on every API call - while the page
#     itself still loads perfectly, so it looks like the app is broken rather
#     than the config.
#  2. The FIRST entry is what verification and password-reset emails link to.
#     Put the canonical public domain first, or students get emailed links to
#     a secondary host.
#
# Production example (custom domain, keeping the Vercel URL working too):
#   CLIENT_URL=https://www.nalandanexus.com,https://nalandanexus.com,https://nalandanexus.vercel.app
#
# The allow-list is logged at startup, so check the Render logs after changing it.
# Must match frontend/vite.config.js's configured dev server port (3000) in dev.
CLIENT_URL=http://localhost:3000

# MongoDB
# Local dev example: mongodb://127.0.0.1:27017/nalanda_student
# MongoDB Atlas example: mongodb+srv://<user>:<password>@cluster0.mongodb.net/nalanda_student
# The db name MUST be explicit in the path — this cluster is shared with the
# teacher and admin backends. Omitting it silently defaults to a database
# literally named "test", colliding with whatever else connects the same way.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/nalanda_student?appName=<appName>

# JWT
JWT_ACCESS_SECRET=change_this_access_secret_in_production
JWT_REFRESH_SECRET=change_this_refresh_secret_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookie SameSite policy for the auth cookies.
# Leave unset for the correct default: "none" in production, "lax" in dev.
# "none" is REQUIRED whenever the frontend and backend are served from
# different registrable domains (e.g. *.vercel.app frontend + *.onrender.com
# backend) - with "strict"/"lax" the browser refuses to send the refresh
# cookie cross-site, so /api/auth/refresh always fails and students are
# silently logged out when the 15-minute access token expires. Only set this
# to "lax" or "strict" if you move both halves under one registrable domain.
# "none" is only honoured on Secure (HTTPS) cookies.
COOKIE_SAMESITE=

# Password reset
PASSWORD_RESET_TOKEN_EXPIRES_MIN=30

# Google Sign-In (Google Identity Services)
# Create an OAuth 2.0 Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials and add your frontend
# origin(s) to "Authorized JavaScript origins". Only the Client ID is needed
# here - the backend verifies ID tokens against Google's public keys, it
# never needs the client secret. Leave blank to disable Google sign-in
# (the endpoint returns GOOGLE_AUTH_NOT_CONFIGURED).
GOOGLE_CLIENT_ID=

# Razorpay
# Get test keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
# Set to "true" only for local/dev/test runs without real Razorpay keys.
# When true, order creation is simulated locally instead of calling the Razorpay API.
# Signature verification still uses real HMAC logic against whatever secret is configured.
PAYMENTS_MOCK_MODE=false

# Email (optional - if unset, emails are logged to console instead of sent)
# Sent via SendGrid's HTTPS API, not SMTP - Render blocks outbound SMTP ports
# (25/465/587) on free-tier web services, so raw SMTP can never work there
# regardless of credentials. Get a key at https://app.sendgrid.com/settings/api_keys
# after verifying the sender address below under Settings > Sender Authentication
# > Single Sender Verification (no domain/DNS ownership required).
SENDGRID_API_KEY=
SMTP_FROM="Nalanda Nexus <nalandanexus@gmail.com>"

# Where Help & Support tickets are emailed. Never exposed to the frontend -
# this backend sends the email itself.
SUPPORT_NOTIFICATION_EMAIL=nalandanexus@gmail.com

# Rate limiting
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# ── Cross-portal bridge (teacher/admin backends) ────────────────────────
# Authenticates POST/PATCH/DELETE /api/internal/* (inbound), which is how a
# published teacher/admin-portal announcement/lecture/material/task/message
# actually reaches students here. Must match STUDENT_BACKEND_SERVICE_KEY in
# teacher/backend/.env.example and admin/backend/.env.example exactly.
# Leave blank to refuse all /api/internal/* calls (INTERNAL_NOT_CONFIGURED)
# rather than silently accepting unauthenticated writes.
INTERNAL_SERVICE_KEY=replace_with_a_long_random_secret_shared_with_teacher_backend

# Outbound half of the messaging bridge: lets a student's message reach the
# teacher backend's own real-time inbox. Leave blank to disable (messages
# still save locally).
TEACHER_BACKEND_URL=http://localhost:5002

# Outbound: lets a real, verified Razorpay payment reach admin/backend's
# payment ledger. Leave blank to disable (the payment still saves/verifies
# locally either way - admin just won't see it).
ADMIN_BACKEND_URL=http://localhost:5003
